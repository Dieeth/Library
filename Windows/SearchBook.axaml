<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Libraria.SearchBook"
        Title="SearchBook">
    <StackPanel HorizontalAlignment="Center">
        <TextBlock Name="Title" Text="Search book!" HorizontalAlignment="Center" FontSize="30" Margin="10" FontFamily="Comic sans MS" VerticalAlignment="Top"/>
        <TextBox Width="300" Watermark="What do you want to find?" Margin="30" Name="Browser"/>

        <Button Content="Search by name" Margin="10" HorizontalAlignment="Center" Click="SearchByName"/>
        <Button Content="Search by author" HorizontalAlignment="Center" Click="SearchByAuthor"/>
        <Button Content="Search by release year" Margin="10" HorizontalAlignment="Center" Click="SearchByReleaseYear"/>
        <Button Content="Search by Genre" HorizontalAlignment="Center" Click="SearchByGenre"/>
        <TextBlock Text="Results:" HorizontalAlignment="Center" Margin="10"/>

        <StackPanel Name="Results">

        </StackPanel>
    </StackPanel>
</Window>
