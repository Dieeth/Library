<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Libraria.MainWindow"
        Title="Libraria">
    <StackPanel>
        <TextBlock Text="Library" HorizontalAlignment="Center" FontSize="50" Margin="40"/>
        <Button Content="New book" Click="AddWindow" HorizontalAlignment="Center"/>
        <Button Content="Search book" Click="SearchWindow" HorizontalAlignment="Center" Margin="10"/>
        <Button Content="Delete book" Click="DeleteWindow" HorizontalAlignment="Center"/>
        <Button Content="Edit book" Click="EditWindow" HorizontalAlignment="Center" Margin="10"/>
        <Button Content="All books" Click="AllBooksWindow" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>
